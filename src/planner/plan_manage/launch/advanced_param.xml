<launch>
  <arg name="is_real_world"/>
  <arg name="navi_mode"/>
  <arg name="sensor_type"/>
  <arg name="body_pose_topic"/>
  <arg name="sensor_pose_topic"/>
  <arg name="cloud_topic"/>
  <arg name="cloud_is_world"/>
  <arg name="depth_topic"/>
  <arg name="cx"/>
  <arg name="cy"/>
  <arg name="fx"/>
  <arg name="fy"/>

  <!-- public parameters -->
  <arg name="max_vel" default="0.75"/>
  <arg name="max_acc" default="2.0"/>
  <arg name="planning_horizon" default="5.0"/>
  <arg name="waypoint_continuous" default="true"/>
  <arg name="waypoint_pass_speed" default="0"/>
  <arg name="escape_enable" default="true"/>
  <!-- max time [s] for one escape move; shared by the FSM and the controller -->
  <arg name="escape_timeout" default="5.0"/>
  <!-- [m] escape arrival distance; shared by the FSM and the controller. The target is
       chosen with this much extra clearance, so stopping short still clears the obstacle. -->
  <arg name="escape_tolerance" default="0.05"/>

  <!-- main node -->
  <!-- required="true": 规划器退出时把整组节点一起带走。closed_loop_controller 是
       独立进程，它一旦收到过 bspline 就不再依赖规划器——会继续按最后那条轨迹
       100Hz 发 cmd_vel（走完轨迹后仍在用 kp_pos 追终点，朝向误差大时还会原地
       转），而 unitree_bridge 的看门狗只在 cmd_vel 停发时才刹停，对这种"上游还
       活着但在发陈旧指令"的情况无能为力。让 roslaunch 连坐把控制器也杀掉，
       cmd_vel 断流，看门狗才能接管。 -->
  <node pkg="scan_planner" name="scan_planner_node" type="scan_planner_node" output="screen" clear_params="true" required="true">
    <remap from="/grid_map/body_pose" to="$(arg body_pose_topic)"/>
    <remap from="/grid_map/sensor_pose" to="$(arg sensor_pose_topic)"/>
    <param name="grid_map/sensor_type" value="$(arg sensor_type)" type="str"/>
    <remap from="/grid_map/cloud" to="$(arg cloud_topic)"/>
    <param name="grid_map/cloud_is_world" value="$(arg cloud_is_world)"/>
    <remap from="/grid_map/depth" to="$(arg depth_topic)"/>
    <param name="grid_map/need_extrinsic" value="$(arg is_real_world)" type="bool"/>

    <!-- planning fsm -->
    <param name="fsm/navi_mode" value="$(arg navi_mode)" type="int"/>
    <param name="fsm/thresh_replan" value="1.0" type="double"/>
    <param name="fsm/thresh_no_replan" value="0.1" type="double"/>
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="fsm/waypoint_arrival_radius" value="0.3" type="double"/>
    <!-- Mode 2: intermediate points carry speed; final / sharp turns / stairs still stop.
         waypoint_pass_speed <= 0 follows manager/max_vel. -->
    <param name="fsm/waypoint_continuous" value="$(arg waypoint_continuous)" type="bool"/>
    <param name="fsm/waypoint_pass_speed" value="$(arg waypoint_pass_speed)" type="double"/>
    <!-- |dz| / horizontal length above which a point keeps the legacy stop (0.15 ~ 8.5 deg). -->
    <param name="fsm/waypoint_max_slope" value="0.15" type="double"/>
    <param name="fsm/emergency_time_" value="1.0" type="double"/>
    <param name="fsm/fail_safe" value="true" type="bool"/> 
    <param name="fsm/max_replan_fail_count" value="1000" type="int"/>
    <param name="fsm/waypoint_skip_fail_count" value="100" type="int"/>
    <param name="fsm/is_real_world" value="$(arg is_real_world)" type="bool"/>
    <!-- Stuck escape: with a target, if the robot neither moves stuck_min_dist nor turns
         stuck_min_yaw for stuck_timeout seconds AND its footprint clearance is below
         double_cylinder_radius + escape_margin, planning pauses and the robot translates
         (heading kept: backing up / side stepping) to the nearest spot within
         escape_search_radius with that clearance, never getting closer to obstacles on
         the way. Then the normal flow resumes from GEN_NEW_TRAJ with a fresh stuck window.
         escape_allow_unknown=false rejects targets in unobserved cells. -->
    <param name="fsm/escape_enable" value="$(arg escape_enable)" type="bool"/>
    <param name="fsm/stuck_timeout" value="10.0" type="double"/>
    <param name="fsm/stuck_min_dist" value="0.15" type="double"/>
    <param name="fsm/stuck_min_yaw" value="0.5" type="double"/>
    <param name="fsm/escape_search_radius" value="1.0" type="double"/>
    <param name="fsm/escape_margin" value="0.1" type="double"/>
    <param name="fsm/escape_reach_dist" value="$(arg escape_tolerance)" type="double"/>
    <param name="fsm/escape_timeout" value="$(arg escape_timeout)" type="double"/>
    <param name="fsm/escape_allow_unknown" value="false" type="bool"/>
    <!-- While moving, the rest of the escape path is re-checked at 20 Hz against the live map;
         if its clearance drops by more than this [m] vs. when it was planned, emergency stop
         (then fail_safe resumes from GEN_NEW_TRAJ). Keep it above one voxel (resolution). -->
    <param name="fsm/escape_abort_eps" value="0.08" type="double"/>

    <!-- sliding map -->
    <param name="grid_map/resolution" value="0.05" />
    <param name="grid_map/sliding_map_size_x" value="10.0" />
    <param name="grid_map/sliding_map_size_y" value="10.0" />
    <param name="grid_map/sliding_map_size_z" value="5.0" />
    <param name="grid_map/map_sliding_thresh" value="0.2"/>
    <param name="grid_map/double_cylinder_radius" value="0.20" />
    <param name="grid_map/double_cylinder_offset" value="0.10" />
    <param name="grid_map/obstacles_inflation_z_up" value="0.1" />
    <param name="grid_map/obstacles_inflation_z_down" value="0.1" />
    <param name="grid_map/body_height" value="0.0" />

    <!-- depth camera intrinsics -->
    <param name="grid_map/cx" value="$(arg cx)"/>
    <param name="grid_map/cy" value="$(arg cy)"/>
    <param name="grid_map/fx" value="$(arg fx)"/>
    <param name="grid_map/fy" value="$(arg fy)"/>

    <!-- depth -->
    <param name="grid_map/depth_filter_maxdist"   value="3.0"/>
    <param name="grid_map/depth_filter_mindist"   value="0.3"/>
    <param name="grid_map/depth_filter_margin"    value="1"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <param name="grid_map/skip_pixel" value="2"/>

    <!-- local fusion -->
    <param name="grid_map/p_hit" value="0.85"/>
    <param name="grid_map/p_miss" value="0.30"/>
    <param name="grid_map/p_min" value="0.12"/>
    <param name="grid_map/p_max" value="0.98"/>
    <param name="grid_map/p_occ" value="0.80"/>
    <param name="grid_map/max_ray_length" value="5.0"/>
    <param name="grid_map/vis_height" value="0.3" type="double"/>

    <!-- planner manager -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4" type="double"/>
    <param name="manager/control_points_distance" value="0.2" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.5" type="double"/>
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <!-- Mode 2 continuous: size local initial polynomials for nonzero boundary speeds. -->
    <param name="manager/boundary_aware_time" value="$(eval arg('navi_mode') == 2 and arg('waypoint_continuous'))" type="bool"/>

    <!-- trajectory optimization -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <param name="optimization/lambda_collision" value="1.0" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.2" type="double"/>
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/vel_tolerance" value="1.0" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="optimization/acc_tolerance" value="1.0" type="double"/>

  </node>

  <!-- trajectory tracking -->
  <param name="closed_loop_controller/time_forward" value="0.8" type="double"/>
  <param name="closed_loop_controller/heading_error_threshold" value="0.8" type="double"/>
  <param name="closed_loop_controller/kp_pos" value="0.8" type="double"/>
  <param name="closed_loop_controller/kp_yaw" value="1.5" type="double"/>
  <param name="closed_loop_controller/max_vx" value="$(arg max_vel)" type="double"/>
  <param name="closed_loop_controller/max_vy" value="0.35" type="double"/>
  <param name="closed_loop_controller/max_vyaw" value="1.0" type="double"/>
  <param name="closed_loop_controller/finish_dist" value="0.15" type="double"/>
  <!-- max time [s] to keep chasing the endpoint after the traj ends; stops (with a WARN) even if not within finish_dist -->
  <param name="closed_loop_controller/finish_timeout" value="3.0" type="double"/>
  <!-- A nonzero endpoint may await its successor for at most 150 ms. -->
  <param name="closed_loop_controller/continuous_handoff" value="$(eval arg('navi_mode') == 2 and arg('waypoint_continuous'))" type="bool"/>
  <param name="closed_loop_controller/handoff_timeout" value="0.15" type="double"/>
  <!-- stuck escape move (planning/escape_goal): constant body-frame speed, heading held -->
  <param name="closed_loop_controller/escape_speed" value="0.3" type="double"/>
  <param name="closed_loop_controller/escape_tolerance" value="$(arg escape_tolerance)" type="double"/>
  <param name="closed_loop_controller/escape_timeout" value="$(arg escape_timeout)" type="double"/>
  <!-- one CSV per tracking session (pose, desired pose, cmd_vel at 100 Hz); empty value disables -->
  <param name="closed_loop_controller/log_dir" value="$(optenv HOME /tmp)/scan_planner_track_logs" type="str"/>

  <!-- 位姿不连续性诊断 (只记录, 不影响控制) —— 依据见 nav_analysis/REPORT_20261001_lou1.md

       定位(grodom)会在正常的 200 Hz 位姿流上叠 ~5 次/s、0.05~0.8 m 的不连续
       (单帧 0.41 m / 5 ms 等效 81 m/s, 物理不可能)。同一条路线两轮对照:
       位置保持帧 2%(200 Hz 连续流)时横向误差 std 0.108 m, 58%(阶梯流)时 0.190/0.225 m。
       控制器闭环在这条流上, 会去追一个并不存在的横向偏移。

       这里**只记录、不改位姿**。原因是先在真机数据上回放验证过"限幅/丢弃"闸门:
       三轮数据、阈值 0.003~0.20 m 全扫, 只要还想保住位置估计的可用性(保留 >=95%
       的交付位移), 横向误差峰值一点不降(0.768 -> 0.768 m); 想把峰值压到 0.52 m
       得扔 45% 的运动量。那几次摆动是十几次同向修正连续叠加 1~2 s 形成的平台,
       不是单帧尖峰 —— 速率限制器只能让它慢, 慢到有意义就等于把运动也限制掉。
       所以控制通路上不留任何与该平台对抗的机构; 这个诊断只是把现象记进 CSV 的
       odom_jump 列 (并在会话结束打一条 WARN), 供离线分析和定位侧改动取证。 -->
  <param name="closed_loop_controller/odom_jump_max_residual" value="0.20" type="double"/>
  <param name="closed_loop_controller/odom_jump_window" value="0.30" type="double"/>

  <!-- 原地转 (heading error 超阈值) 时的偏航限幅 —— 只在需要时改这一个参数

       控制器在 |yaw_err| > heading_error_threshold 时会进入"原地转"支路
       (closed_loop_controller.cpp 里 publishStop 那一段): 纵向指令清零, 只发角速度。
       本参数把这条支路的角速度单独夹住, 默认 = max_vyaw (不改行为)。

       **为什么要单独一个参数**: 这条支路原先直接发 vyaw_cmd, 想压低转速只能改代码;
       而 2026-10-01 在板子上只改了那个只用于写日志的 turn_cmd, 结果机器人照旧收 0.5、
       CSV 里却写着 0.2, 日志反而不可信。现在下发的值与写日志的值同源。

       **改之前先知道代价** (实测数据):
         * kp_yaw=1.5 时, 顶格门槛 = turn_vyaw_max/1.5。填 0.2 -> |yaw_err|>7.6° 就顶格
           (原来 0.5 对应 19°), 原地转时长大约翻倍。
         * 原地转越久 -> "纵向指令为 0" 的窗口越长 -> 斜面上后溜越多。实测所有后溜
           事件 (0.2~0.4 m) 都落在 frozen 窗口里。
         * 提 max_vyaw / 降这个值对"大幅左右摆"都没有帮助: 那些摆动是位姿流不连续
           (5~19 次/s、5~30 cm) 造成的, 不是航向回路在过摆 (跨轮相关性也不支持)。
       验证方式: 同一条路线每档跑 2~3 遍 —— 定位质量逐轮差 5 倍, 单次对照没有意义。 -->
  <param name="closed_loop_controller/turn_vyaw_max" value="0.2" type="double"/>

</launch>
